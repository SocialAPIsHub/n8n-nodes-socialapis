{
	"name": "n8n-nodes-socialapis",
	"version": "0.2.0",
	"description": "n8n community node for SocialAPIs: public Facebook and Instagram data (pages, posts, groups, Ads Library, Marketplace, profiles, reels). No OAuth.",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"facebook",
		"instagram",
		"social-media",
		"ads-library",
		"marketplace",
		"scraper",
		"socialapis"
	],
	"license": "MIT",
	"homepage": "https://socialapis.io",
	"author": {
		"name": "SocialAPIs",
		"email": "support@socialapis.io"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/SocialAPIsHub/n8n-nodes-socialapis.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SocialApisApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/SocialApis/SocialApis.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.50.5",
		"eslint": "^9.39.4",
		"prettier": "^3.8.3",
		"release-it": "^20.2.0",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
